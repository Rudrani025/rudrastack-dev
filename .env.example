# Client-side (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — never expose to the browser
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (server-side only)
# LOVABLE_API_KEY is used to send transactional emails via the Lovable email API.
# EMAIL_SENDER_DOMAIN must be a verified sender domain for the project.
LOVABLE_API_KEY=
EMAIL_SENDER_DOMAIN=
ADMIN_EMAIL=
